/// Orders.
// <- comment.documentation
schema shop.orders @sql(schema: "shop")
// <- keyword
//     ^ module
//                 ^ attribute
//                      ^ property
//                              ^ string

import shop.customers as cust
// <- keyword
//                    ^ keyword
//                       ^ module

alias Money = decimal(19, 4)
// <- keyword
//    ^ type
//            ^ type.builtin
//                    ^ number

enum Status { pending paid }
// <- keyword
//   ^ type
//            ^ constant
//                    ^ constant

/// An order.
model Order {
// <- keyword
//    ^ type
  #1 id uuid { id }
// ^ constant
//   ^ property
//      ^ type.builtin
//             ^ property
  #2 who cust.Customer @relation(onDelete: cascade)
//   ^ property
//            ^ type
//                     ^ attribute
//                      ^ attribute
//                               ^ property
//                                         ^ constant
  #3 status Status = pending
//          ^ type
//                   ^ constant
  #4 date date
//   ^ property
//        ^ type.builtin
  #5 note string? { max 500 } // trailing
//              ^ operator
//                  ^ property
//                      ^ number
//                              ^ comment
  #6 ok bool = true
//             ^ boolean
  #7 lines Line[] { minItems 1 }
//              ^ punctuation.bracket
//                  ^ property
  #8 kind enum { a b }
//        ^ keyword
//               ^ constant
  reserved #9, "legacy"
// ^ keyword
//             ^ string

  model Line { sku string }
//^ keyword
//      ^ type

  @@index(who, status)
//^ attribute
//  ^ attribute
//        ^ property
}

service Orders {
// <- keyword
//      ^ type
  #1 get(OrderId): Order  get "/orders/{id}"
// ^ constant
//   ^ function
//       ^ type
//                 ^ type
//                        ^ keyword
//                            ^ string
  #2 upload(stream Chunk): stream Receipt
//          ^ keyword
//                 ^ type
//                         ^ keyword
}
