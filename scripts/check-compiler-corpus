#!/usr/bin/env bash
# Parses every schema file the compiler ships and tests against, and fails if any tree holds an
# error or a missing node, or if the number of doc_comment nodes differs from the number of lines
# that begin with `///` (in a file the compiler accepts, each of those is a doc comment).
set -euo pipefail

compiler="${1:?usage: check-compiler-corpus <path to a Schemata compiler checkout>}"
compiler="$(cd "$compiler" && pwd)"
cd "$(dirname "$0")/.."

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(
  # Excluded fixture groups: the SCH0* fixtures cover the syntax and lexical diagnostics of the
  # compiler (not all of them are parse errors here, but none is a valid file), and the new side of
  # the SCH2503 compatibility fixture is a field with no type.
  find "$compiler/examples" "$compiler/schemata-cli/src/test/resources" \
    -name '*.schemata' \
    -not -path '*/diagnostics/SCH0*' \
    -not -path '*/diagnostics/SCH2503/new/*' \
    -print0 | sort -z
)

if [ "${#files[@]}" -lt 100 ]; then
  echo "found only ${#files[@]} schema files under $compiler; expected well over 100" >&2
  exit 1
fi

failed=0
for file in "${files[@]}"; do
  if ! tree="$(npx tree-sitter parse "$file" 2>/dev/null)"; then
    echo "does not parse cleanly: ${file#"$compiler"/}"
    failed=$((failed + 1))
    continue
  fi
  slashes="$(grep -c '^[[:space:]]*///' "$file" || true)"
  docs="$(grep -c '(doc_comment' <<< "$tree" || true)"
  if [ "$slashes" -ne "$docs" ]; then
    echo "doc comments differ: ${file#"$compiler"/} has $slashes lines starting with /// but $docs doc_comment nodes"
    failed=$((failed + 1))
  fi
done

echo "${#files[@]} files, $failed with errors"
[ "$failed" -eq 0 ]
